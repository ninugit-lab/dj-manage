# === Django ===
# Key generieren: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=app.dj-redoo.de
SECURE_COOKIES=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# === Spotify (Redirect-URI auch in Spotify-Dashboard eintragen) ===
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://app.dj-redoo.de/spotify/callback/

# === Google (Redirect-URI auch in Google-Cloud-Console eintragen) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.dj-redoo.de/google/callback/

# === Cloudflare Tunnel (Token aus CF Zero-Trust Dashboard) ===
TUNNEL_TOKEN=

# === Gunicorn ===
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
